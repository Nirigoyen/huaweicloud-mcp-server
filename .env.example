# Huawei Cloud credentials (REQUIRED)
HUAWEI_ACCESS_KEY=your-access-key-here
HUAWEI_SECRET_KEY=your-secret-key-here

# Huawei Cloud region (OPTIONAL - defaults to cn-north-4)
# HUAWEI_REGION=cn-north-4

# MCP Server configuration (OPTIONAL - overrides config.yaml)
# MCP_SERVER_MODE=stdio
# MCP_SERVER_PORT=8888
