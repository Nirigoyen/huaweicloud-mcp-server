{
  "mcpServers": {
    "huaweicloud-ecs": {
      "command": "uv",
      "args": [
        "--directory",
        "/home/nico/ai-projects/huaweicloud-mcp-server",
        "run",
        "mcp-server-ecs",
        "-t",
        "stdio"
      ],
      "env": {
        "HUAWEI_ACCESS_KEY": "YOUR_ACCESS_KEY",
        "HUAWEI_SECRET_KEY": "YOUR_SECRET_KEY",
        "HUAWEI_REGION": "cn-north-4"
      }
    },
